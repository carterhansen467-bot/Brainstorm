# macOS
.DS_Store

# Editor / working backups
*.bak
*.bak2

# Local debug & diagnostics output
brainstorm_diagnostics.txt

# User state, rewritten by the mod at runtime (never track: tracked copies
# made every git pull conflict for players)
settings.lua
debug_predict.txt

# Native search helper: locally built binary + its runtime handshake files
native/brainstorm_native_search
native/brainstorm_seed_pool
native_search.cfg
native_search.status
native_search.status.tmp
native_search.stop
native_search.hb
brainstorm_mismatch.txt

# External exhaustive seed-pool output (can be tens of gigabytes)
seed_pools/
*.bspool
*.bspool.state
*.bspool.manifest

# Windows build outputs (release zips carry the prebuilt exes)
native/*.exe
native/*.pdb
